{
  "format": "cofferwire-conformance-registry-v1",
  "revisions": {
    "queue-v1": "CW-SCOPE-QUEUE-V1-2026-09-06",
    "blob-v1": "CW-BLOB-1-DRAFT-2026-09-06",
    "receipts-v1": "CW-RECEIPT-1-DRAFT-2026-09-06",
    "offline-v1": "CW-OFFLINE-1-DRAFT-2026-09-06"
  },
  "tests": {
    "RUST-TYPES": {
      "command": "cargo test -p cofferwire-types",
      "category": "codec",
      "roles": ["client", "relay"],
      "security_properties": ["bounded-values", "closed-enums"]
    },
    "RUST-CODEC": {
      "command": "cargo test -p cofferwire-codec && cargo test -p cofferwire-test --test wire_cddl",
      "category": "codec",
      "roles": ["client", "relay"],
      "security_properties": ["canonical-encoding", "bounded-parsing", "version-rejection"]
    },
    "RUST-CRYPTO": {
      "command": "cargo test -p cofferwire-crypto",
      "category": "crypto",
      "roles": ["client", "relay"],
      "security_properties": ["authentication", "confidentiality", "domain-separation"]
    },
    "RUST-CLIENT": {
      "command": "cargo test -p cofferwire-client",
      "category": "client",
      "roles": ["client"],
      "security_properties": ["persist-before-ack", "retry-safety", "deduplication"]
    },
    "RUST-RELAY": {
      "command": "cargo test -p cofferwire-relay",
      "category": "relay",
      "roles": ["relay"],
      "security_properties": ["durability", "authorization", "atomicity"]
    },
    "RUST-TRANSPORT": {
      "command": "cargo test -p cofferwired",
      "category": "transport",
      "roles": ["client", "relay"],
      "security_properties": ["transport-independence", "resource-bounds"]
    },
    "RUST-BLOB-VECTORS": {
      "command": "cargo test -p cofferwire-test --test blob_vectors",
      "category": "crypto",
      "roles": ["client", "relay"],
      "security_properties": ["blob-integrity", "ciphertext-identity", "capability-separation"]
    },
    "TRACEABILITY-SELFTEST": {
      "command": "python3 -m unittest scripts.tests.test_check_conformance",
      "category": "quality",
      "roles": ["client", "relay"],
      "security_properties": ["specification-coverage"]
    },
    "PYTHON-INDEPENDENT": {
      "command": "python3 -m unittest discover -s independent/python/tests -v",
      "category": "independent",
      "roles": ["client", "relay"],
      "security_properties": ["canonical-encoding", "authentication", "confidentiality", "durability", "independent-interpretation"]
    },
    "QUEUE-V1-INTEROP-MATRIX": {
      "command": "python3 scripts/run_interop_matrix.py --output /tmp/cofferwire-interop-matrix.json",
      "category": "interoperability",
      "roles": ["client", "relay"],
      "security_properties": ["cross-implementation", "retry-safety", "version-rejection"]
    },
    "RUST-RECEIPT": {
      "command": "cargo test -p cofferwire-crypto -p cofferwire-client",
      "category": "crypto",
      "roles": ["client"],
      "security_properties": ["end-to-end-authentication", "device-binding", "replay-resistance"]
    },
    "RUST-RECEIPT-VECTORS": {
      "command": "cargo test -p cofferwire-test --test receipt_vectors",
      "category": "crypto",
      "roles": ["client"],
      "security_properties": ["positive-vectors", "tampered-rejection"]
    },
    "RUST-OFFLINE": {
      "command": "cargo test -p cofferwire-client",
      "category": "client",
      "roles": ["client"],
      "security_properties": ["confidentiality", "device-binding", "idempotent-import", "relay-independence"]
    },
    "RUST-OFFLINE-VECTORS": {
      "command": "cargo test -p cofferwire-test --test offline_vectors",
      "category": "crypto",
      "roles": ["client"],
      "security_properties": ["positive-vectors", "tampered-rejection"]
    }
  },
  "mappings": [
    {"prefix": "CW-TERM-", "revision": "queue-v1", "tests": ["RUST-TYPES", "RUST-CLIENT", "PYTHON-INDEPENDENT"]},
    {"prefix": "CW-THREAT-", "revision": "queue-v1", "tests": ["RUST-CRYPTO", "RUST-CLIENT", "RUST-RELAY", "RUST-TRANSPORT", "PYTHON-INDEPENDENT"]},
    {"prefix": "CW-ARCH-", "revision": "queue-v1", "tests": ["RUST-CLIENT", "RUST-RELAY", "RUST-TRANSPORT", "PYTHON-INDEPENDENT", "QUEUE-V1-INTEROP-MATRIX"]},
    {"prefix": "CW-CRYPTO-", "revision": "queue-v1", "tests": ["RUST-CRYPTO", "PYTHON-INDEPENDENT", "QUEUE-V1-INTEROP-MATRIX"]},
    {"prefix": "CW-WIRE-", "revision": "queue-v1", "tests": ["RUST-TYPES", "RUST-CODEC", "PYTHON-INDEPENDENT", "QUEUE-V1-INTEROP-MATRIX"]},
    {"prefix": "CW-QUEUE-", "revision": "queue-v1", "tests": ["RUST-RELAY", "RUST-CLIENT", "PYTHON-INDEPENDENT", "QUEUE-V1-INTEROP-MATRIX"]},
    {"prefix": "CW-STORE-", "revision": "queue-v1", "tests": ["RUST-RELAY", "PYTHON-INDEPENDENT"]},
    {"prefix": "CW-TRANSPORT-", "revision": "queue-v1", "tests": ["RUST-TRANSPORT"]},
    {"prefix": "CW-VERSION-", "revision": "queue-v1", "tests": ["RUST-CODEC", "TRACEABILITY-SELFTEST", "PYTHON-INDEPENDENT", "QUEUE-V1-INTEROP-MATRIX"]},
    {"prefix": "CW-BLOB-", "revision": "blob-v1", "tests": ["RUST-BLOB-VECTORS", "TRACEABILITY-SELFTEST"]},
    {"prefix": "CW-RECEIPT-", "revision": "receipts-v1", "tests": ["RUST-RECEIPT", "RUST-RECEIPT-VECTORS", "TRACEABILITY-SELFTEST"]},
    {"prefix": "CW-OFFLINE-", "revision": "offline-v1", "tests": ["RUST-OFFLINE", "RUST-OFFLINE-VECTORS", "TRACEABILITY-SELFTEST"]}
  ],
  "should_exceptions": []
}
